{
  "name": "h-util-ui",
  "version": "1.0.0",
  "description": "UI based hoarder util",
  "main": "./dist/Electron/main.js",
  "license": "MIT",
  "author": "",
  "private": true,
  "scripts": {
    "build": "npm run build:electron && npm run build:front",
    "build:electron": "tsc",
    "test": "jest",
    "watch": "nodemon --exec \"npm run serve:electron\"",
    "dev": "npm start",
    "start": "concurrently --names \"CLIENT-KUN,PACKARINO\" --prefix-colors \"red,yellow\" -k \"npm run serve:front\" \"npm run watch\"",
    "front:setup": "npm install --prefix client",
    "electron:setup": "npm install",
    "setup": "npm run front:setup && npm run electron:setup",
    "serve:front": "npm run dev --prefix client -- --host 127.0.0.1 --port 3000",
    "serve:electron": "node ./scripts/serve-electron.cjs",
    "build:front": "npm run build --prefix client",
    "electron:build": "npm run build",
    "electron:builder": "npm exec -- electron-builder --config electron-builder.config.cjs",
    "electron:builder:win": "npm exec -- electron-builder build --win --x64 --config electron-builder.config.cjs",
    "app:build": "npm run build && npm run electron:builder",
    "app:build:win": "npm run build && npm run electron:builder:win",
    "app:build:nightly": "node ./scripts/build-nightly.cjs",
    "electron-rebuild": "npm exec -- electron-rebuild",
    "postinstall": "npm exec -- electron-builder install-app-deps",
    "up:win": "up_using_window.cmd",
    "packages:sync": "cd .. && cp ./packages/common/src/* ./h-util-ui/Electron/packages/common/ && cp ./packages/fileops/src/* ./h-util-ui/Electron/packages/fileops/"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/module-alias": "^2.0.4",
    "concurrently": "^7.6.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^3.2.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "jest": "^29.7.0",
    "json": "^11.0.0",
    "nodemon": "^2.0.20",
    "prettier": "^3.3.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.4",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "colors": "^1.4.0",
    "dateformat": "^4.6.3",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "electron-unhandled": "^5.0.0",
    "electron-updater": "^6.8.9",
    "exif": "^0.6.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "module-alias": "^2.2.3",
    "tesseract.js": "^5.1.0",
    "uuid": "^14.0.0",
    "winston": "^3.14.2"
  },
  "workspaces": [
    "../packages/fileops",
    "../packages/common"
  ],
  "type": "commonjs",
  "repository": "https://github.com/TestaDiMucca/Hoarder-Util",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  }
}
